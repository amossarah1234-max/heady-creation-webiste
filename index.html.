            <a href="#contact">Contact</a>
        </nav>

    </header>


    <!-- HERO SECTION -->

    <section class="hero" id="home">

        <div class="hero-content">

            <h1>
                Creative Ideas.<br>
                <span>Exceptional Designs.</span>
